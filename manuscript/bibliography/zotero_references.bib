@online{derricoAutomaticTopographyHighdimensional2021,
  title = {Automatic Topography of High-Dimensional Data Sets by Non-Parametric {{Density Peak}} Clustering},
  author = {family=Errico, given=Maria, prefix=d', useprefix=true and Facco, Elena and Laio, Alessandro and Rodriguez, Alex},
  date = {2021-02-05},
  eprint = {1802.10549},
