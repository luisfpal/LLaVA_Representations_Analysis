@article{faccoEstimatingIntrinsicDimension2017,
  title = {Estimating the Intrinsic Dimension of Datasets by a Minimal Neighborhood Information},
  author = {Facco, Elena and family=Errico, given=Maria, prefix=d’, useprefix=true and Rodriguez, Alex and Laio, Alessandro},
  date = {2017-09-22},
  journaltitle = {Scientific Reports},
