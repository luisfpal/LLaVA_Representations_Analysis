\RequirePackage{threeparttable}


% === Bibliography (biblatex) ===
\RequirePackage[
  backend=biber,
  style=numeric-comp,        % numeric citations [1], [1-3]
  giveninits=true,         % initials for first names
  maxbibnames=99,          % show all authors in the bibliography
  doi=false,                % show DOI for academic papers
  url=false,                % show URLs for all entries
  urldate=false,            % show urldate for all entries
  eprint=false,             % show arXiv links
  isbn=false,              % hide ISBN
  sorting=none,            % maintain order of appearance
  defernumbers=true,       % number references as they appear
  maxcitenames=2,          % "et al." in citations after 2
  date=year                % print only the year if a full date is present
]{biblatex}

% Ultra-minimal cleanup (removes unwanted metadata fields)
\AtEveryBibitem{%
  \clearfield{abstract}%
  \clearfield{file}%
  \clearfield{keywords}%
  \clearfield{shorttitle}%
  \clearfield{pubstate}%
  \clearfield{eprintclass}%
  \clearfield{eprinttype}%
  % keep 'note' if you plan to mark "Dataset" there
  % \clearfield{note}%
  \clearlist{language}%
}

% Show URL and urldate fields only for @online entries
\DeclareFieldFormat{url}{%  
  \ifentrytype{online}{\mkbibacro{URL}\addcolon\space\url{#1}}{}%
}
\DeclareFieldFormat{urldate}{%
  \ifentrytype{online}{}{}%
}

% Make titles hyperlinks to DOI/URL for non-online entries
\DeclareFieldFormat{title}{%
  \ifentrytype{online}{#1}{%
    \iffieldundef{doi}{%
      \iffieldundef{url}{#1}{\href{\thefield{url}}{#1}}%
    }{\href{https://doi.org/\thefield{doi}}{#1}}%
  }%
}

% Optional: remove "In:" before venues for a cleaner look
\renewbibmacro{in:}{}

% === Hyperref (must be last) ===
\RequirePackage{hyperref}
\RequirePackage{xspace}
\RequirePackage{etoolbox}
\RequirePackage{bookmark}

% === Colors and Lists ===
