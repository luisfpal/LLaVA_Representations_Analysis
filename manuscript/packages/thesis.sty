% === Dummy Text ===
\RequirePackage{lipsum}

% === Page Style ===
\RequirePackage{fancyhdr}

% === Chapter Style Setup ===
\renewcommand{\chaptermark}[1]{\markboth{Chapter \thechapter. #1}{}} 

% === Setup Functions ===
\newcommand{\setupThesis}{
    % Page numbering
    \pagenumbering{arabic}
    
    % Equation numbering - continuous from 1 onwards
    \renewcommand{\theequation}{\arabic{equation}}
    
    % Page style
    \pagestyle{fancy}
    \fancyhf{}
    \fancyhead[C]{\nouppercase{\leftmark}}
    \fancyfoot[C]{\thepage}
    
    
    % Hyperref setup
    \hypersetup{
      colorlinks=true,
      citecolor=blue,
      filecolor=blue,
      linkcolor=blue,
        urlcolor=blue
    }
}
