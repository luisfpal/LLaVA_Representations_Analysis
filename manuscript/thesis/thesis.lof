\contentsline {figure}{\numberline {1.1}{\ignorespaces LLaVA v1.5 architecture. The model consists of a vision encoder (CLIP-ViT-L-336px) \blx@tocontentsinit {0}\cite {radfordLearningTransferableVisual2021}, a language model backbone (Vicuna v1.5) \blx@tocontentsinit {0}\cite {vicuna2023}, and an MLP projection layer. Adapted from \blx@tocontentsinit {0}\cite {liuImprovedBaselinesVisual2024}. }}{9}{figure.caption.7}%
\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces LLaMA-style pre-norm decoder block and the two tap points for the residual stream extraction: \textbf {(1)} per-head attention projection after $W^O$ (pre-residual connection), \textbf {(2)} output of the decoder layer. }}{22}{figure.caption.15}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Layer-wise similarity between fine-tuned and pretrained LLaVA. (a) NO (left) and Linear CKA (right) for COCOVQA text and VQA. Higher values indicate greater cross-checkpoint similarity. (b) Text-multimodal difference (green: NO, red: linear CKA); positive values mean higher similarity on text than multimodal. }}{30}{figure.caption.20}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Head-wise NO between fine-tuned and pretrained LLaVA. Annotations mark extreme values (white: top/bottom 5\% within layer; red: global top 5\%; orange: global bottom 5\%). (a) Text (left) and visual (right) QA on COCOVQA. (b) Text-multimodal difference (negative: higher multimodal similarity; positive: higher text similarity). }}{31}{figure.caption.22}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Intrinsic dimension analysis for text QA (orange), visual QA (blue), and captioning (green) on COCOVQA. (a) Finetuned model (left) and pretrained model (right). Higher values indicate higher-dimensional (less compact) representations. (b) ID difference (pretrained $-$ finetuned). Positive values mean the pretrained model has higher ID. }}{33}{figure.caption.24}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Cosine similarity between the most contextualized text and image representations of the finetuned (blue) and pretrained (red) LLaVA, for image captioning (left) and visual QA (right) on the multimodal subset of COCOVQA. Higher values indicate stronger directional alignment. }}{35}{figure.caption.27}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Homogeneity after clustering text and image embeddings together (same tasks as in Figure~\ref {fig:cosine_similarity_text_image}). A value of~1 indicates perfectly separated modality clusters; lower values indicate stronger mixing. }}{35}{figure.caption.28}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces COCOVQA question answering accuracy for hybrid models formed by cumulatively transplanting the first $k$ LLM-backbone layers from the finetuned model into the pretrained model (light-blue bars). The x-axis is $k$ (0-indexed, starting from the bottom layer). Left: text-only QA. Right: visual QA. Red and green bars denote the pretrained (PM) and finetuned (FM) references, respectively. }}{37}{figure.caption.32}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Image captioning performance under cumulative transplantation of the first $k$ backbone layers from the finetuned model into the pretrained model (light-blue bars). The x-axis is $k$ (0-indexed). Left: CIDEr. Right: CLIP-S. Green and red bars show the finetuned (FM) and pretrained (PM) references, respectively. }}{38}{figure.caption.33}%
