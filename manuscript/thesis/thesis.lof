\contentsline {figure}{\numberline {A.1}{\ignorespaces Similar to Figure \ref {fig:layer_wise_similarity_cocovqa} but the values are the mean of the head-wise neighborhood overlap matrices of the text and multimodal similarites in Figure~\ref {fig:heads_wise_similarity_cocovqa}. }}{42}{figure.caption.35}%
\contentsline {figure}{\numberline {A.2}{\ignorespaces Dataset Entropy. Similar to Figure~\ref {fig:intrinsic_dimension}. }}{43}{figure.caption.36}%
\contentsline {figure}{\numberline {A.3}{\ignorespaces Similar to Figure \ref {fig:accuracy_question_answering_cumulative} but using the sliding window transplantation approach. The layer numbers on the x-axis are the starting layers of the window of layers transplanted from the finetuned model to the pretrained model. Here, the window size is 1 and the step size is 2. The finetuned references are: 0.74 for text QA and 0.66 for visual QA. }}{43}{figure.caption.37}%
\contentsline {figure}{\numberline {A.4}{\ignorespaces Similar to \ref {fig:cider_clip_score_image_captioning_cumulative} but using the sliding window transplantation approach. The x-axis is as in \ref {fig:accuracy_question_answering_sliding_window}. The finetuned references are: 0.82 for CIDEr and 0.22 for CLIP-S. }}{44}{figure.caption.38}%
